{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model Council Agent Card",
  "type": "object",
  "required": ["name", "role", "description", "capabilities", "boundaries"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "capabilities": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "boundaries": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
