{
  "project_name": "model-council-demo",
  "state_dir": "runtime",
  "max_parallel": 3,
  "manager": "manager",
  "reviewer": "reviewer",
  "providers": {
    "mock-local": {
      "kind": "mock",
      "display_name": "Local offline mock provider",
      "enabled": true
    }
  },
  "models": {
    "mock-general": {
      "provider": "mock-local",
      "display_name": "Mock general model",
      "capabilities": [
        "planning",
        "architecture",
        "implementation",
        "research",
        "review"
      ],
      "enabled": true
    }
  },
  "agents": {
    "manager": {
      "type": "mock",
      "provider": "mock-local",
      "model": "mock-general",
      "role": "管理员",
      "description": "拆解目标、划分边界、协调冲突并整合最终答案。",
      "capabilities": ["plan", "route", "synthesize"],
      "boundaries": ["不得直接修改用户项目", "不得绕过编排器扩大权限"]
    },
    "architect": {
      "type": "mock",
      "provider": "mock-local",
      "model": "mock-general",
      "role": "架构师",
      "description": "负责系统边界、模块关系、数据流和技术风险。",
      "capabilities": ["architecture", "risk_analysis"],
      "boundaries": ["只提交设计建议，不直接部署"]
    },
    "implementer": {
      "type": "mock",
      "provider": "mock-local",
      "model": "mock-general",
      "role": "实现工程师",
      "description": "负责落地步骤、代码结构和工程实现建议。",
      "capabilities": ["implementation", "testing"],
      "boundaries": ["MVP中只提交方案和补丁建议，不修改外部目录"]
    },
    "researcher": {
      "type": "mock",
      "provider": "mock-local",
      "model": "mock-general",
      "role": "研究员",
      "description": "负责备选方案、兼容性和现有生态调查。",
      "capabilities": ["research", "comparison"],
      "boundaries": ["必须标记不确定信息"]
    },
    "reviewer": {
      "type": "mock",
      "provider": "mock-local",
      "model": "mock-general",
      "role": "独立审查员",
      "description": "检查不同模型结论之间的冲突、遗漏和不可执行假设。",
      "capabilities": ["review", "verification"],
      "boundaries": ["不替代管理员做最终业务决策"]
    }
  },
  "role_assignments": {
    "decision_manager": {
      "mode": "manual",
      "agent": "manager",
      "model": "mock-general",
      "locked": true
    },
    "detail_executor": {
      "mode": "hybrid",
      "agent": "implementer",
      "model": "mock-general",
      "constraints": {
        "required_capabilities": ["implementation"]
      }
    },
    "independent_reviewer": {
      "mode": "manual",
      "agent": "reviewer",
      "model": "mock-general",
      "locked": true
    }
  },
  "settings": {
    "locale": "zh-CN",
    "auto_discovery_on_start": false
  }
}
