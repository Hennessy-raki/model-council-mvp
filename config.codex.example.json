{
  "project_name": "model-council-codex-pilot",
  "state_dir": "runtime-codex-pilot",
  "max_parallel": 2,
  "manager": "manager",
  "reviewer": "reviewer",
  "providers": {
    "mock-local": {
      "kind": "mock",
      "display_name": "Local offline mock provider",
      "enabled": true
    },
    "codex-local": {
      "kind": "cli",
      "display_name": "Local Codex CLI",
      "enabled": true
    }
  },
  "models": {
    "mock-general": {
      "provider": "mock-local",
      "display_name": "Mock general model",
      "capabilities": ["planning", "implementation", "review"],
      "enabled": true,
      "pricing": {
        "input_per_million": 0,
        "output_per_million": 0,
        "currency": "USD"
      }
    },
    "codex-configured-default": {
      "provider": "codex-local",
      "display_name": "Codex configured default model",
      "capabilities": ["architecture", "code_analysis"],
      "enabled": true,
      "metadata": {
        "selection": "Inherited from the local Codex configuration"
      }
    }
  },
  "agents": {
    "manager": {
      "type": "mock",
      "provider": "mock-local",
      "model": "mock-general",
      "role": "管理员",
      "description": "第一轮仍使用模拟管理员，避免一次引入过多变量。",
      "capabilities": ["plan", "synthesize"],
      "boundaries": ["不得直接修改用户项目"]
    },
    "codex_architect": {
      "type": "cli",
      "provider": "codex-local",
      "model": "codex-configured-default",
      "role": "Codex架构师",
      "description": "通过 Codex 非交互模式完成一个只读分析任务。",
      "capabilities": ["architecture", "code_analysis"],
      "boundaries": ["只读", "不得部署", "不得删除文件"],
      "command": [
        "codex.cmd",
        "exec",
        "--ephemeral",
        "--skip-git-repo-check",
        "--sandbox",
        "read-only",
        "--color",
        "never",
        "--json",
        "-"
      ],
      "output_format": "codex_jsonl",
      "discovery_timeout_seconds": 30,
      "timeout_seconds": 600
    },
    "implementer": {
      "type": "mock",
      "provider": "mock-local",
      "model": "mock-general",
      "role": "实现工程师",
      "description": "负责工程落地建议。",
      "capabilities": ["implementation", "testing"],
      "boundaries": ["只提交建议"]
    },
    "reviewer": {
      "type": "mock",
      "provider": "mock-local",
      "model": "mock-general",
      "role": "独立审查员",
      "description": "审查各模型输出。",
      "capabilities": ["review", "verification"],
      "boundaries": ["不执行外部写操作"]
    }
  },
  "role_assignments": {
    "decision_manager": {
      "mode": "manual",
      "agent": "manager",
      "model": "mock-general",
      "locked": true
    },
    "architecture_lead": {
      "mode": "manual",
      "agent": "codex_architect",
      "model": "codex-configured-default",
      "locked": true,
      "constraints": {
        "required_capabilities": ["architecture"]
      }
    },
    "detail_executor": {
      "mode": "hybrid",
      "agent": "implementer",
      "model": "mock-general",
      "constraints": {
        "required_capabilities": ["implementation"],
        "separation": {
          "roles": ["decision_manager"],
          "dimensions": ["agent"]
        }
      }
    },
    "independent_reviewer": {
      "mode": "manual",
      "agent": "reviewer",
      "model": "mock-general",
      "locked": true,
      "constraints": {
        "required_capabilities": ["review"],
        "separation": {
          "roles": ["decision_manager"],
          "dimensions": ["agent"]
        }
      }
    }
  },
  "settings": {
    "locale": "zh-CN",
    "auto_discovery_on_start": false,
    "usage_estimation_enabled": true
  },
  "budgets": {
    "codex-pilot-project-tokens": {
      "scope": "project",
      "metric": "tokens",
      "warning": 500000
    }
  }
}
